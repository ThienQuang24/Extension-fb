{
    "manifest_version": 3,
    "name": "Facebook Auto Manager",
    "version": "2.0.0",
    "description": "Tự động tìm kiếm, crawl bài viết Facebook và quản lý đăng bài lên fanpage",
    "permissions": [
        "storage",
        "tabs",
        "scripting",
        "alarms"
    ],
    "host_permissions": [
        "*://*.facebook.com/*"
    ],
    "background": {
        "service_worker": "src/background/index.ts",
        "type": "module"
    },
    "action": {
        "default_popup": "index.html",
        "default_icon": {
            "16": "icons/icon-16.png",
            "32": "icons/icon-32.png",
            "48": "icons/icon-48.png",
            "128": "icons/icon-128.png"
        }
    },
    "content_scripts": [
        {
            "matches": [
                "*://*.facebook.com/*"
            ],
            "js": [
                "src/content/index.ts"
            ],
            "run_at": "document_end"
        }
    ],
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "assets/*"
            ],
            "matches": [
                "*://*.facebook.com/*"
            ]
        }
    ]
}